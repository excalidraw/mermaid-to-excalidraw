erDiagram
    %% Overlapping active loans require a separate constraint such as an exclusion constraint or application-level validation.

    COLLECTION ||--o{ OBJECT : contains
    COLLECTION {
        int collection_id PK
        string name
        string description
    }

    OBJECT ||--o{ OBJECT_CREATOR : "attributed in"
    OBJECT ||--o{ MOVEMENT : tracks
    OBJECT ||--o{ LOAN_ITEM : "included in"
    OBJECT {
        int object_id PK
        string accession_number UK
        int collection_id FK
        string title
        string medium
        string dimensions
        int current_location_id FK
    }

    CREATOR ||--o{ OBJECT_CREATOR : created
    CREATOR {
        int creator_id PK
        string full_name
        string nationality
        date birth_date
        date death_date
    }

    OBJECT_CREATOR {
        int object_id PK, FK
        int creator_id PK, FK
        string role
        string attribution_type "optional"
    }

    LOCATION ||--o{ MOVEMENT : "as origin"
    LOCATION ||--o{ MOVEMENT : "as destination"
    LOCATION ||--o{ OBJECT : "currently houses"
    LOCATION {
        int location_id PK
        string room_number
        string shelf_code
        string building
        string location_type
    }

    MOVEMENT {
        int movement_id PK
        int object_id FK
        int origin_location_id FK
        int destination_location_id FK
        datetime movement_timestamp
        string authorized_by
        string notes
    }

    BORROWING_INSTITUTION ||--o{ LOAN : borrows
    BORROWING_INSTITUTION {
        int institution_id PK
        string name
        string contact_person
        string contact_email
        string address
    }

    LOAN ||--|{ LOAN_ITEM : contains
    LOAN {
        int loan_id PK
        int institution_id FK
        string loan_agreement_number UK
        date start_date
        date end_date
        string status
    }

    LOAN_ITEM {
        int loan_id PK, FK
        int object_id PK, FK
        string item_condition_on_out
        string item_condition_on_return
        string insurance_value
    }
