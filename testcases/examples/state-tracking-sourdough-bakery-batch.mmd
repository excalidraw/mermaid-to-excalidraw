%% model: gemini_3_8_flash
%% prompt: 26. Tracking a sourdough bakery batch (prompts.md)
stateDiagram-v2
    [*] --> Planned
    Planned --> Mixing: Ingredients Scaled and Autolyse Complete
    Mixing --> BulkFermenting: Desired Dough Development Reached

    state BulkFermenting {
        [*] --> Resting
        Resting --> Folding: Scheduled Fold Triggered [foldsCompleted < maxFolds]
        Folding --> Resting: Fold Applied [increment foldsCompleted]
        Resting --> CheckBulkReadiness: Ferment Window Elapsed [foldsCompleted >= minFolds]

        state CheckBulkReadiness <<choice>>
        CheckBulkReadiness --> Resting: Under-Fermented [gas and volume insufficient]
        CheckBulkReadiness --> [*]: Fermentation Target Met [dough aerated and domed]
    }

    BulkFermenting --> Dividing: Bulk Fermentation Complete
    Dividing --> Shaping: Portioned and Pre-Shaped
    Shaping --> Proofing: Final Shape Loaded into Bannetons
    Proofing --> Baking: Passed Poke Test [optimal expansion]
    Baking --> Cooling: Baked to Internal Target
    Cooling --> QualityCheck: Cooled to Ambient Temperature

    state QualityCheck <<choice>>
    QualityCheck --> Released: Meets Standards [crumb, crust, and volume optimal]
    QualityCheck --> Hold: Discrepancy Found [marginal defect or requires lab review]
    QualityCheck --> Rejected: Fails Standards [severe defect or contamination]

    Hold --> Released: Disposition Approved [reclassified or waiver granted]
    Hold --> Rejected: Disposition Denied [unfit for consumption or sale]

    Released --> [*]
    Rejected --> [*]
