%% model: gemini_3_8_flash
%% prompt: 18. Storing a city's public-transit timetable (prompts.md)
erDiagram
    AGENCY ||--o{ ROUTE : "operates"
    ROUTE ||--o{ TRIP : "contains"
    SERVICE_CALENDAR ||--o{ TRIP : "schedules"
    SERVICE_CALENDAR ||--o{ SERVICE_EXCEPTION : "modified_by"
    TRIP ||--|{ STOP_TIME : "includes"
    STOP ||--o{ STOP_TIME : "located_at"

    AGENCY {
        string agency_id PK
        string agency_name
        string agency_url
        string agency_timezone
    }

    ROUTE {
        string route_id PK
        string agency_id FK
        string route_short_name
        string route_long_name
        int route_type
    }

    SERVICE_CALENDAR {
        string service_id PK
        boolean monday
        boolean tuesday
        boolean wednesday
        boolean thursday
        boolean friday
        boolean saturday
        boolean sunday
        date start_date
        date end_date
    }

    SERVICE_EXCEPTION {
        string service_id PK, FK
        date date PK
        int exception_type
    }

    TRIP {
        string trip_id PK
        string route_id FK
        string service_id FK
        string trip_headsign
        int direction_id
    }

    STOP {
        string stop_id PK
        string stop_name
        float stop_lat
        float stop_lon
    }

    STOP_TIME {
        string trip_id PK, FK
        int stop_sequence PK
        string stop_id FK
        time arrival_time
        time departure_time
        int pickup_type
        int drop_off_type
    }
