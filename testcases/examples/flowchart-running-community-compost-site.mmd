flowchart TD
    subgraph IntakeStage["Intake & Sorting Stage"]
        A["Arrival of Garden Waste and Food Scraps"] --> B{"Inspect Material"}
        B -- "Unsuitable or Hazardous" --> C["Reject Material and Divert to Landfill"]
        B -- "Acceptable" --> D["Manual Contamination Removal"]
        D --> E["Sort Materials"]
        E --> F1["Greens: Nitrogen-Rich Food and Fresh Waste"]
        E --> F2["Browns: Carbon-Rich Garden Waste and Dry Leaves"]
    end

    subgraph ActiveStage["Active Processing Stage"]
        F1 --> G["Mix Greens and Browns in Carbon-to-Nitrogen Ratio"]
        F2 --> G
        G --> H["Build Active Compost Pile"]
        H --> I["Active Aerobic Composting and Temperature Monitoring"]
        I --> J{"Check Moisture Level"}
        J -- "Too Dry" --> K["Add Water and Turn Pile"]
        K --> I
        J -- "Too Wet" --> L["Add Dry Browns and Turn Pile"]
        L --> I
        J -- "Moisture Optimal" --> M{"Check Decomposition Level"}
        M -- "Insufficiently Decomposed" --> N["Turn Pile for Aeration"]
        N --> I
    end

    subgraph FinishedStage["Finishing & Distribution Stage"]
        M -- "Sufficiently Decomposed" --> O["Curing Phase for Stabilization"]
        O --> P["Mechanical Screening"]
        P -- "Oversized Residual Material" --> G
        P -- "Finished Fine Compost" --> Q["Quality and Safety Testing"]
        Q --> R["Community Distribution and Garden Use"]
    end

    subgraph LoggingBranch["Monitoring Branch"]
        S["Log Batch Observations: Moisture, Temp, Odor, Volume"]
    end

    I -.-> S
    J -.-> S
    M -.-> S
    O -.-> S

