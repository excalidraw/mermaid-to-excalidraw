%% model: gemini_3_flash_preview
%% prompt: 1. Rescuing a bakery's surplus food (prompts.md)
sequenceDiagram
    autonumber
    actor Customer
    participant App as Mobile App
    participant IS as Inventory Service
    participant PS as Payment Service
    participant Bakery

    Customer->>App: Browse available food bags
    App->>IS: Get surplus inventory (Bakery)
    IS-->>App: List available bags

    Customer->>App: Select last available bag
    App->>IS: Reserve bag (Temporary Lock)

    alt Bag already taken by competing customer
        IS-->>App: Error: Bag no longer available
        App-->>Customer: Show "Sold Out" notification
    else Bag successfully reserved
        IS-->>App: Success: Bag reserved (10 min lock)

        App->>PS: Process payment details

        alt Payment Failed
            PS-->>App: Payment Declined
            App->>IS: Release reservation lock
            IS-->>App: Lock released
            App-->>Customer: Payment failed, please try again
        else Payment Successful
            PS-->>App: Payment Confirmed
            App->>IS: Finalize reservation
            IS->>IS: Update inventory (Count = 0)
            IS-->>App: Reservation ID: #12345
            App-->>Customer: Display pickup voucher

            opt Pickup Reminder
                IS->>App: Trigger push notification (1 hour before)
                App->>Customer: Reminder: Pick up your bag at Bakery
            end

            Customer->>Bakery: Arrive for evening pickup
            Bakery->>App: Scan/Verify voucher
            App->>IS: Mark as "Collected"
            Bakery->>Customer: Hand over surplus food bag
        end
    end
