%% model: gemini_3_8_flash
%% prompt: 28. Mapping animal foster-placement records (prompts.md)
erDiagram
    %% Business Rule: An animal's placements cannot overlap in time.
    %% Distinction: The sample rows show non-overlapping dates (e.g. A-01: 2025-03-02 to 2025-03-10 then 2025-03-11 onward), but this is an enforced temporal domain constraint rather than a guarantee derived solely from row data.

    ANIMAL ||--o{ PLACEMENT : "has"
    FOSTER_HOME ||--o{ PLACEMENT : "hosts"

    ANIMAL["ANIMAL (3 rows)"] {
        string animal_id PK "e.g. A-01, A-02, A-03"
        string name "e.g. Maple, Comet, Pip"
        string species "e.g. Cat, Dog, Rabbit"
        date intake_date "e.g. 2025-03-01, 2025-03-03"
    }

    FOSTER_HOME["FOSTER_HOME (2 rows)"] {
        string home_id PK "e.g. H-01, H-02"
        string display_name "e.g. Riverside Home, Oak Street Home"
        int capacity "e.g. 2, 1"
    }

    PLACEMENT["PLACEMENT (3 rows)"] {
        string placement_id PK "e.g. P-01, P-02, P-03"
        string animal_id FK "e.g. A-01, A-02"
        string home_id FK "e.g. H-01, H-02"
        date start_date "e.g. 2025-03-02, 2025-03-04"
        date end_date "e.g. 2025-03-10, null (current)"
    }
